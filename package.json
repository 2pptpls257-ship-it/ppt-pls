{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/api-server --filter @workspace/ppt-pls --parallel run dev",
    "dev:web": "pnpm --filter @workspace/ppt-pls run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build:web": "pnpm --filter @workspace/ppt-pls run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build": "pnpm --filter @workspace/ppt-pls run build && node -e \"const fs=require('fs'); fs.cpSync('artifacts/ppt-pls/dist/public', 'public', {recursive:true}); fs.cpSync('artifacts/ppt-pls/dist/public', 'dist', {recursive:true});\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
